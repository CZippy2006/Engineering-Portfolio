rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio projects collection:
    // Anyone (recruiters, visitors) can read and view projects
    // ONLY Christian Astill (astillcd@gmail.com / christian@astill.org) can write, update, or delete
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null && 
        (
          request.auth.token.email == 'astillcd@gmail.com' ||
          request.auth.token.email == 'christian@astill.org' ||
          (request.auth.token.email != null && request.auth.token.email.matches('.*@astill[.]org$'))
        );
    }

    // Fallback for any other documents
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        (
          request.auth.token.email == 'astillcd@gmail.com' ||
          request.auth.token.email == 'christian@astill.org' ||
          (request.auth.token.email != null && request.auth.token.email.matches('.*@astill[.]org$'))
        );
    }
  }
}

